server {
    listen 80;
    server_name stock-course.example.com;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://stock-course.example.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name stock-course.example.com;
    ssl_certificate /etc/letsencrypt/live/stock-course.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stock-course.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 7m;
    client_body_timeout 15s;
    access_log /var/log/nginx/stock.access.log;
    error_log /var/log/nginx/stock.error.log;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
